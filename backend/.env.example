# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Gemini (used by the interpretation service)
GOOGLE_API_KEY=your-gemini-api-key

DATABASE_URL=sqlite:///./rhythm.db

# Oura OAuth app (cloud.ouraring.com → My Applications)
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_REDIRECT_URI=http://localhost:8000/oura/callback

# Google Calendar OAuth client (Google Cloud Console → Credentials)
GCAL_CLIENT_ID=your-google-oauth-client-id
GCAL_CLIENT_SECRET=your-google-oauth-client-secret
GCAL_REDIRECT_URI=http://localhost:8000/calendar/callback
