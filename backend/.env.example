# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" hides /docs and /openapi.json. Leave as development locally.
ENVIRONMENT=development
# The old unauthenticated single-user API (dashboard / menu bar app). Off by default; set to true only
# for local work on those apps. Never on a public host.
LEGACY_ENDPOINTS_ENABLED=false

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local development (after `supabase start`): use these values as-is.
#   SUPABASE_URL=http://127.0.0.1:54321
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
#
# Hosted Rhythm project: Project Settings → API → Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Connect → Session pooler. Change the "postgresql://" prefix to
# "postgresql+psycopg://" and put your database password in place of [YOUR-PASSWORD].
# Migrations refuse non-local hosts unless run with -x allow_remote=true.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# Leave empty when the project uses JWT signing keys (verified via JWKS).
# Only set it if the project still signs with the legacy shared JWT secret.
SUPABASE_JWT_SECRET=
# Backend only: account deletion uses Supabase's admin API. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sign in with Apple (backend only: revokes Apple tokens on account deletion) ─
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key from Apple Developer → Keys; newlines may be written as \n
APPLE_PRIVATE_KEY=

# Legacy single-user SQLite used by the pre-Supabase endpoints (default shown).
# LEGACY_DATABASE_URL=sqlite:///./rhythm.db

# ── Generated locally (see README / setup notes) ─────────────────────────────
TOKEN_ENCRYPTION_KEY=generate-with-fernet
OAUTH_STATE_SECRET=generate-with-secrets-token-urlsafe

# ── Interpretation (LLM phrasing of engine output; OpenAI) ───────────────────
# platform.openai.com → API keys
OPENAI_API_KEY=your-openai-api-key
# Optional; defaults to gpt-4.1-mini
INTERPRETATION_MODEL=gpt-4.1-mini

# ── Oura OAuth app (cloud.ouraring.com → My Applications) ────────────────────
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_REDIRECT_URI=http://localhost:8000/oura/callback

# ── Google Calendar OAuth client (Cloud Console → Credentials) ───────────────
GCAL_CLIENT_ID=your-google-oauth-client-id
GCAL_CLIENT_SECRET=your-google-oauth-client-secret
GCAL_REDIRECT_URI=http://localhost:8000/calendar/callback

# ── Tests (local Supabase stack from `supabase start`) ───────────────────────
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
